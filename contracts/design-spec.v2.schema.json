{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "An explicit named frame in body-local coordinates. Its +Y axis is the outward normal\nof the mating face; attached bodies meet it with their own anchor normal opposed.",
      "properties": {
        "accepts": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Accepts",
          "type": "array"
        },
        "bolt_pattern_mm": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 64,
          "title": "Bolt Pattern Mm",
          "type": "array"
        },
        "diameter_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diameter Mm"
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "rigid",
          "enum": [
            "rigid",
            "hinge",
            "shaft",
            "slide",
            "bolt",
            "face",
            "slot",
            "side"
          ],
          "title": "Kind",
          "type": "string"
        },
        "verified": {
          "const": false,
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Attachment": {
      "additionalProperties": false,
      "description": "How a child meets its parent: the child's `child_anchor` face is placed against the\nparent's `parent_anchor` face (normals opposed, upright when possible). offset_mm then\nmoves the child along the PARENT body's axes (x right, y up, z front); rotation_deg\n(XYZ Euler) and the joint `axis` turn it about the parent anchor point, in the parent's\naxes. Hinge `value`/`limits` are degrees, slide ones millimetres.",
      "properties": {
        "adjust_mm": {
          "default": 0,
          "maximum": 500,
          "minimum": 0,
          "title": "Adjust Mm",
          "type": "number"
        },
        "axis": {
          "default": "Y",
          "enum": [
            "X",
            "Y",
            "Z"
          ],
          "title": "Axis",
          "type": "string"
        },
        "child_anchor": {
          "default": "bottom",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Child Anchor",
          "type": "string"
        },
        "clearance_mm": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Clearance Mm",
          "type": "number"
        },
        "contact": {
          "default": "touch",
          "enum": [
            "touch",
            "fastened",
            "clearance",
            "embedded"
          ],
          "title": "Contact",
          "type": "string"
        },
        "fasteners": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fastener"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "joint": {
          "default": "rigid",
          "enum": [
            "rigid",
            "hinge",
            "shaft",
            "slide",
            "bolt",
            "face",
            "slot",
            "side"
          ],
          "title": "Joint",
          "type": "string"
        },
        "limits": {
          "default": [
            0,
            0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Limits",
          "type": "array"
        },
        "offset_mm": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Offset Mm",
          "type": "array"
        },
        "parent_anchor": {
          "default": "top",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Parent Anchor",
          "type": "string"
        },
        "rotation_deg": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation Deg",
          "type": "array"
        },
        "value": {
          "default": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "title": "Attachment",
      "type": "object"
    },

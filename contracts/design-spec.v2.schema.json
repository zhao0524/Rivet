            },
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            }
          ],
          "title": "Printer Volume Mm",
          "type": "array"
        },
        "units": {
          "const": "mm",
          "default": "mm",
          "title": "Units",
          "type": "string"
        },
        "up_axis": {
          "const": "Y",
          "default": "Y",
          "title": "Up Axis",
          "type": "string"
        }
      },
      "title": "Constraints",
      "type": "object"
    },

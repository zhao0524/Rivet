    "Feature": {
      "additionalProperties": false,
      "description": "A bounded feature applied to the body's solid, in the body's local frame.\n\nhole/counterbore: radius_mm, depth_mm along `axis` from position_mm (count/spacing_mm\n  repeat along pattern_axis). boss/rib: additive cylinder / plate. fillet/chamfer:\n  radius_mm on edge set `edges`. shell: hollow with wall_mm, open on `open_face`.\nslot/window/pocket: width_mm x length_mm cut, depth_mm deep (window cuts through).\ngrill: `count` slots of width_mm x length_mm, spacing_mm apart.",
      "properties": {
        "axis": {
          "default": "Y",
          "enum": [
            "X",
            "Y",
            "Z"
          ],
          "title": "Axis",
          "type": "string"
        },
        "count": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "counterbore_depth_mm": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Counterbore Depth Mm",
          "type": "number"
        },
        "counterbore_radius_mm": {
          "default": 4,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Counterbore Radius Mm",
          "type": "number"
        },
        "depth_mm": {

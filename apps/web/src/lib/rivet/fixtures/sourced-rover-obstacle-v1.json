  "assembly_steps": [
    {
      "step": 1,
      "title": "Prepare the chassis",
      "instance_ids": [
        "chassis-1"
      ],
      "instructions": "Assemble the chassis plates and check its mounting points.",
      "safety_notes": []
    },
    {
      "step": 2,
      "title": "Mount the motors",
      "instance_ids": [
        "motor-left-1",
        "motor-right-1"
      ],
      "instructions": "Fix each motor into its motor mount with the shaft pointing outward.",
      "safety_notes": []
    },
    {
      "step": 3,
      "title": "Fit the wheels and caster",
      "instance_ids": [
        "wheel-left-1",
        "wheel-right-1",
        "caster-1"
      ],
      "instructions": "Press each wheel onto its motor shaft and attach the caster.",
      "safety_notes": []
    },
    {
      "step": 4,
      "title": "Mount the electronics",
      "instance_ids": [
        "controller-1",
        "driver-1",
        "sensor-1"
      ],
      "instructions": "Fix the boards to their mounting points; the range sensor faces forward.",
      "safety_notes": [
        "Keep every power supply disconnected during this step."
      ]
    },
    {
      "step": 5,
      "title": "Place the power supplies",
      "instance_ids": [
        "power-motor-1",
        "power-control-1"
      ],
      "instructions": "Secure the power supplies. Leave them disconnected, with no batteries inserted.",
      "safety_notes": [
        "Keep every power supply disconnected during this step."
      ]
    },
    {
      "step": 6,
      "title": "Lay out wiring supplies",
      "instance_ids": [
        "accessory-1",
        "accessory-2",
        "accessory-3",
        "accessory-4",
        "accessory-5",
        "accessory-6"
      ],
      "instructions": "Set out the breadboard, wires and adapters used in the next steps.",
      "safety_notes": [
        "Keep every power supply disconnected during this step."
      ]
    },
    {
      "step": 7,
      "title": "Wire logic supply and control signals",
      "instance_ids": [
        "controller-1",
        "driver-1",
        "sensor-1"
      ],
      "instructions": "Connect: controller-1.gpio25 to driver-1.pwma (MOTOR_LEFT_PWM); controller-1.gpio26 to driver-1.ain1 (MOTOR_LEFT_IN1); controller-1.gpio27 to driver-1.ain2 (MOTOR_LEFT_IN2); controller-1.gpio32 to driver-1.pwmb (MOTOR_RIGHT_PWM); controller-1.gpio33 to driver-1.bin1 (MOTOR_RIGHT_IN1); controller-1.gpio18 to driver-1.bin2 (MOTOR_RIGHT_IN2); controller-1.gpio19 to driver-1.stby (MOTOR_STANDBY); controller-1.gpio21 to sensor-1.sda (I2C_SDA); controller-1.gpio22 to sensor-1.scl (I2C_SCL); controller-1.v3v3 to driver-1.vcc (V_LOGIC); controller-1.v3v3 to sensor-1.vin (V_LOGIC).",
      "safety_notes": [
        "Keep every power supply disconnected during this step."
      ]
    },
    {
      "step": 8,
      "title": "Wire the motors",
      "instance_ids": [
        "driver-1",
        "motor-left-1",
        "motor-right-1"
      ],
      "instructions": "Connect each driver output to a motor terminal: driver-1.ao1 to motor-left-1.terminal_1 (MOTOR_LEFT_A); driver-1.ao2 to motor-left-1.terminal_2 (MOTOR_LEFT_B); driver-1.bo1 to motor-right-1.terminal_1 (MOTOR_RIGHT_A); driver-1.bo2 to motor-right-1.terminal_2 (MOTOR_RIGHT_B).",
      "safety_notes": [
        "Keep every power supply disconnected during this step.",
        "If a wheel spins backwards later, swap that motor's two leads."
      ]
    },
    {
      "step": 9,
      "title": "Wire the common ground",
      "instance_ids": [
        "controller-1",
        "driver-1",
        "power-motor-1",
        "sensor-1"
      ],
      "instructions": "Connect every ground together: controller-1.gnd to driver-1.gnd (GND); sensor-1.gnd to driver-1.gnd (GND); power-motor-1.gnd to driver-1.gnd (GND).",
      "safety_notes": [
        "Keep every power supply disconnected during this step."
      ]
    },
    {
      "step": 10,
      "title": "Check the wiring before power",
      "instance_ids": [
        "controller-1",
        "driver-1",
        "motor-left-1",
        "motor-right-1",
        "power-control-1",
        "power-motor-1",
        "sensor-1"
      ],
      "instructions": "Compare every wire against the netlist. Confirm supply polarity, that the motor supply goes only to the driver's motor input, and that all grounds are joined.",
      "safety_notes": [
        "Keep every power supply disconnected during this step.",
        "Do not continue until every connection matches the netlist."
      ]
    },
    {
      "step": 11,
      "title": "Connect power",
      "instance_ids": [
        "controller-1",
        "driver-1",
        "power-control-1",
        "power-motor-1"
      ],
      "instructions": "Only after the wiring check passes, connect the supplies: power-motor-1.v_out to driver-1.vm (V_MOTOR); power-control-1.usb_a_out to controller-1.usb_5v_in (V_CONTROLLER).",
      "safety_notes": [
        "Lift the wheels off the table for the first power-up.",
        "Disconnect the motor supply immediately if anything gets hot or smells."
      ]
    }
  ],

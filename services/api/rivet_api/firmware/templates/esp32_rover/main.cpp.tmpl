// Generated by Rivet (template main.cpp.tmpl) for build {{BUILD_ID}} revision {{REVISION}}.
// Obstacle avoidance state machine: FORWARD -> STOP -> TURN -> FORWARD, with DISABLED.
// The microcontroller only drives the motor driver's logic inputs; motor current never
// flows through ESP32 pins. Supervise the rover and keep a way to cut motor power.
#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_VL53L0X.h>
#include "rivet_config.h"

enum class State { DISABLED, FORWARD, STOP, TURN };

static const int PWM_FREQ_HZ = 20000;
static const int PWM_RESOLUTION_BITS = 8;
static const int LEFT_CHANNEL = 0;
static const int RIGHT_CHANNEL = 1;

static Adafruit_VL53L0X lox;
static bool sensor_ok = false;
static State state = State::DISABLED;
static unsigned long turn_started_ms = 0;

// speed is -255..255; positive is forward.
static void set_motor(int in1, int in2, int channel, int speed) {
  if (speed > 0) {
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
  } else if (speed < 0) {
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
  } else {
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }
  ledcWrite(channel, abs(speed));
}

void stop_motors() {
  set_motor(PIN_MOTOR_LEFT_IN1, PIN_MOTOR_LEFT_IN2, LEFT_CHANNEL, 0);
  set_motor(PIN_MOTOR_RIGHT_IN1, PIN_MOTOR_RIGHT_IN2, RIGHT_CHANNEL, 0);
}

void drive_forward() {
  set_motor(PIN_MOTOR_LEFT_IN1, PIN_MOTOR_LEFT_IN2, LEFT_CHANNEL, RIVET_FORWARD_PWM);
  set_motor(PIN_MOTOR_RIGHT_IN1, PIN_MOTOR_RIGHT_IN2, RIGHT_CHANNEL, RIVET_FORWARD_PWM);
}

void turn_in_place() {
  set_motor(PIN_MOTOR_LEFT_IN1, PIN_MOTOR_LEFT_IN2, LEFT_CHANNEL, RIVET_FORWARD_PWM);
  set_motor(PIN_MOTOR_RIGHT_IN1, PIN_MOTOR_RIGHT_IN2, RIGHT_CHANNEL, -RIVET_FORWARD_PWM);
}

// Distance to the nearest obstacle in millimetres, or -1 when there is no valid reading.
// A missing reading is treated as unsafe by the state machine (the rover stops).
int read_front_distance() {
  VL53L0X_RangingMeasurementData_t measure;
  lox.rangingTest(&measure, false);
  if (measure.RangeStatus == 4) {
    return -1;
  }
  return measure.RangeMilliMeter;
}

static void disable_rover() {
  state = State::DISABLED;
  stop_motors();
  digitalWrite(PIN_MOTOR_STANDBY, LOW);
}

// Serial commands: 'x' = DISABLE (immediate), 'g' = enable.
static void handle_serial() {
  while (Serial.available() > 0) {
    int c = Serial.read();
    if (c == 'x' || c == 'X') {
      disable_rover();
      Serial.println("DISABLED");
    } else if (c == 'g' || c == 'G') {
      if (state == State::DISABLED && sensor_ok) {
        state = State::FORWARD;
        Serial.println("ENABLED");
      } else if (!sensor_ok) {
        Serial.println("Cannot enable: distance sensor not found");
      }
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_MOTOR_LEFT_IN1, OUTPUT);
  pinMode(PIN_MOTOR_LEFT_IN2, OUTPUT);
  pinMode(PIN_MOTOR_RIGHT_IN1, OUTPUT);
  pinMode(PIN_MOTOR_RIGHT_IN2, OUTPUT);
  pinMode(PIN_MOTOR_STANDBY, OUTPUT);
  digitalWrite(PIN_MOTOR_STANDBY, LOW);
  ledcSetup(LEFT_CHANNEL, PWM_FREQ_HZ, PWM_RESOLUTION_BITS);
  ledcSetup(RIGHT_CHANNEL, PWM_FREQ_HZ, PWM_RESOLUTION_BITS);
  ledcAttachPin(PIN_MOTOR_LEFT_PWM, LEFT_CHANNEL);
  ledcAttachPin(PIN_MOTOR_RIGHT_PWM, RIGHT_CHANNEL);
  stop_motors();

  Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);
  sensor_ok = lox.begin();
  if (!sensor_ok) {
    Serial.println("VL53L0X not found: motors stay disabled");
  }
  Serial.print("Rivet build ");
  Serial.print(RIVET_BUILD_ID);
  Serial.print(" r");
  Serial.print(RIVET_REVISION);
  Serial.print(" plan status ");
  Serial.println(RIVET_PLAN_STATUS);
  Serial.println("Disabled at boot. Send 'g' to enable, 'x' to disable.");
  if (RIVET_START_ENABLED && sensor_ok) {
    state = State::FORWARD;
  }
}

void loop() {
  handle_serial();
  if (state == State::DISABLED) {
    stop_motors();
    digitalWrite(PIN_MOTOR_STANDBY, LOW);
    delay(10);
    return;
  }
  digitalWrite(PIN_MOTOR_STANDBY, HIGH);

  switch (state) {
    case State::FORWARD: {
      int distance_mm = read_front_distance();
      if (distance_mm < 0) {
        stop_motors();
      } else if (distance_mm < RIVET_OBSTACLE_STOP_MM) {
        stop_motors();
        state = State::STOP;
      } else {
        drive_forward();
      }
      break;
    }
    case State::STOP:
      turn_started_ms = millis();
      turn_in_place();
      state = State::TURN;
      break;
    case State::TURN:
      if (millis() - turn_started_ms >= RIVET_TURN_DURATION_MS) {
        stop_motors();
        state = State::FORWARD;
      }
      break;
    default:
      stop_motors();
      break;
  }
  delay(20);
}

# Rivet env template: names and safe defaults only, never real keys.
#
# The root scripts (pnpm dev, dev:api, dev:web, build) load env through scripts/load-env.sh:
# .env, then .env.local; a later file wins and a variable already set in your shell wins
# over both. .env is the team's shared file, committed encrypted with git-crypt
# (scripts/setup-env.sh unlocks it); change it only by team agreement. While it is still
# encrypted or missing, this file is loaded in its place.
# Personal keys and overrides go in .env.local at the repo root (gitignored).

# --- API (services/api reads these from its environment) ---
RIVET_MODE=fixture                # fixture | live
RIVET_ENV=development             # free-form label
RIVET_DATA_ROOT=./data            # runtime data; relative to services/api when the scripts start it
RIVET_DEMO_FIXTURE=rover_obstacle_v1
RIVET_VISION_PROVIDER=mock        # mock | openai | backboard. openai is the documented live provider;
                                  # backboard is unsupported for the demo (image input unverified)
RIVET_VISION_MODEL=               # required for openai or backboard, e.g. gpt-4o
RIVET_ENABLE_ESTELLE=false        # true only with the Estelle CLI installed and logged in
RIVET_ESTELLE_MODE=cli            # cli | mcp (mcp always reports unavailable)
# RIVET_ESTELLE_REPO=             # repo Estelle grounds against; default: this repo
RIVET_RESOLVER=stub               # stub | engine | engine-recorded. engine resolvers need rivet_engine installed
RIVET_OFFERS_PROVIDER=stub        # stub | recorded | live. stub answers from fixtures/offers (never a live lookup);
                                  # recorded replays saved vendor pages; live fetches the web (needs keys below)

# --- v2 geometry-first design workspace (apps/web /design). RIVET_3D_MODE=live is explicit and
# needs OPENAI_API_KEY; anything else runs the labelled offline author and every result is a fixture. ---
RIVET_3D_MODE=fixture             # fixture | live. live authors real geometry with OpenAI; never falls back to fixtures
RIVET_DESIGN_MODEL=               # author model in live mode; default: RIVET_VISION_MODEL, else gpt-4o
RIVET_IMAGE_PROVIDER=none         # none | openai. openai renders image previews (needs OPENAI_API_KEY)
RIVET_IMAGE_MODEL=gpt-image-1     # used only when RIVET_IMAGE_PROVIDER=openai
RIVET_IMAGE_SIZE=1024x1024
RIVET_IMAGE_QUALITY=medium        # low | medium | high
RIVET_RENDERER=raster             # raster (deterministic CPU z-buffer) | chromium (three.js headless; needs web deps)

# --- Server-only keys: put them in .env.local, never in .env. The web app never gets them. ---
# OPENAI_API_KEY=                 # required for RIVET_VISION_PROVIDER=openai
# BACKBOARD_API_KEY=              # required for RIVET_VISION_PROVIDER=backboard
# BACKBOARD_LLM_PROVIDER=openai
# BACKBOARD_BASE_URL=https://app.backboard.io/api
# BRAVE_SEARCH_API_KEY=           # RIVET_OFFERS_PROVIDER=live: web search for candidate vendor pages
# NEXAR_CLIENT_ID=                # Octopart/Nexar structured offers (optional; unset = source reported as needs_api_key)
# NEXAR_CLIENT_SECRET=
# MOUSER_API_KEY=                 # Mouser structured offers (optional)
# DIGIKEY_CLIENT_ID=              # DigiKey structured offers (optional)
# DIGIKEY_CLIENT_SECRET=
# ELEMENT14_API_KEY=              # element14 / Newark / Farnell structured offers (optional)

# --- Local dev ports (scripts/dev.sh) ---
RIVET_API_PORT=8000
RIVET_WEB_PORT=3000

# --- Web app (apps/web). Next.js reads env files only from apps/web/. pnpm dev passes both
# values itself: from your env if set, else derived from RIVET_API_PORT and RIVET_MODE; it also
# writes apps/web/.env.local if missing, for running the web app on its own. ---
# NEXT_PUBLIC_RIVET_API_URL=http://localhost:8000   # where the web app's /api rewrite sends requests
# NEXT_PUBLIC_RIVET_USE_FIXTURES=true               # true: built-in fixtures; false: use the API

# --- Not read by any code (the engine loads its packaged catalog); listed in docs/implementation.md §1 ---
# RIVET_CATALOG_PATH=./data/catalog/components.json

# Template only. The real .env is committed encrypted (git-crypt); run scripts/setup-env.sh.
# Without the key, copy this file to .env and fill in values.
RIVET_ENV=development
RIVET_MODE=fixture                # fixture | live
RIVET_VISION_PROVIDER=mock        # mock | openai | backboard
RIVET_VISION_MODEL=               # required for openai/backboard, e.g. gpt-4o
BACKBOARD_API_KEY=                # server only; required when provider=backboard
BACKBOARD_LLM_PROVIDER=openai     # openai | anthropic | google | xai | openrouter
OPENAI_API_KEY=                   # server only; required when provider=openai
RIVET_DATA_ROOT=./data
RIVET_CATALOG_PATH=./data/catalog/components.json
RIVET_DEMO_FIXTURE=rover_obstacle_v1
RIVET_ENABLE_ESTELLE=false        # real connection only when installed/authenticated
RIVET_ESTELLE_MODE=cli            # cli | mcp ; gate by real connectivity
NEXT_PUBLIC_RIVET_API_URL=http://localhost:8000
NEXT_PUBLIC_RIVET_USE_FIXTURES=true
